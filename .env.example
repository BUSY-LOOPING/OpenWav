S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET_AUDIO=audio
S3_BUCKET_COVERS=covers
AUDIO_CACHE_MAX_SIZE=20g
COVER_CACHE_MAX_SIZE=2g

STREAM_SIGNING_SECRET=change-me-stream-secret
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

SCRAPER_URL=http://localhost:8100
SCRAPER_CACHE_TTL_SEC=21600
SCRAPER_TIMEOUT_SEC=8
SCRAPER_MAX_CONCURRENCY=4

RECOMMENDER_CONTENT_WEIGHT=0.3
RECOMMENDER_TRAIN_INTERVAL_SEC=1800
RECOMMENDER_TRAIN_AFTER_EVENTS=500
MODEL_DIR=./services/recommender/data

RECOMMENDER_URL=http://localhost:8000
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9464
CONCURRENT_DOWNLOADS=3
PROMETHEUS_RETENTION=15d

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

OPS_USER=admin
OPS_PASSWORD=change-me-ops

ALERT_WEBHOOK_URL=
