NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
PUBLIC_BASE_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443,http://localhost:6330
TLS_COMMON_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=openwav
POSTGRES_USER=openwav
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://openwav:change-me-postgres@localhost:5432/openwav
DB_POOL_SIZE=10

REDIS_PASSWORD=change-me-redis
