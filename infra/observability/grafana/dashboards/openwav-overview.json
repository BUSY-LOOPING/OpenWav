{
  "uid": "openwav-overview",
  "title": "OpenWav Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "tags": [
    "openwav"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum by (service) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency P50 / P95 / P99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:http_request_duration_seconds:p50",
          "legendFormat": "p50 {{service}}"
        },
        {
          "refId": "B",
          "expr": "service:http_request_duration_seconds:p95",
          "legendFormat": "p95 {{service}}"
        },
        {
          "refId": "C",
          "expr": "service:http_request_duration_seconds:p99",
          "legendFormat": "p99 {{service}}"
        },
        {
          "refId": "D",
          "expr": "openwav:threshold_p95_seconds",
          "legendFormat": "p95 threshold"
        },
        {
          "refId": "E",
          "expr": "openwav:threshold_p99_seconds",
          "legendFormat": "p99 threshold"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rabbitmq_queue_messages{queue=~\"downloads.*|playlists\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Download job duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(download_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(download_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "sum by (status) (rate(download_jobs_total[15m]))",
          "legendFormat": "jobs/s {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Recommender training",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(recommender_train_duration_seconds_bucket[1h])))",
          "legendFormat": "train p95"
        },
        {
          "refId": "B",
          "expr": "increase(recommender_train_duration_seconds_count[1h])",
          "legendFormat": "trains / hour"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Edge connections (nginx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "alertlist",
      "title": "Active alerts",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 6
      },
      "options": {
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true
        },
        "groupMode": "default",
        "viewMode": "list"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}