proxy_cache_path /var/cache/nginx/audio levels=1:2 keys_zone=audio_cache:50m max_size=${AUDIO_CACHE_MAX_SIZE} inactive=30d use_temp_path=off;
proxy_cache_path /var/cache/nginx/covers levels=1:2 keys_zone=cover_cache:20m max_size=${COVER_CACHE_MAX_SIZE} inactive=90d use_temp_path=off;

upstream api {
  server ${UPSTREAM_API};
  keepalive 32;
}

upstream storage {
  server ${UPSTREAM_STORAGE};
  keepalive 32;
}

map $request_uri $stream_uri {
  ~^(?<path>[^?]*) $path;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' '';
}

server {
  listen 80;
  server_name _;
  return 301 https://$host$request_uri;
}

server {
  listen 8081;
  access_log off;
  location = /nginx_status {
    stub_status;
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name _;

  ssl_certificate /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Request-Id $request_id always;

  location /api/ {
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_read_timeout 60s;
  }

  location = /api/v1/progress {
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    add_header X-Accel-Buffering no;
  }

  location /stream/ {
    secure_link $arg_md5,$arg_expires;
    secure_link_md5 "$secure_link_expires$stream_uri ${STREAM_SIGNING_SECRET}";
    if ($secure_link = "") { return 403; }
    if ($secure_link = "0") { return 410; }

    rewrite ^/stream/(.*)$ /${S3_BUCKET_AUDIO}/$1? break;

    slice 1m;
    proxy_cache audio_cache;
    proxy_cache_key $uri$slice_range;
    proxy_cache_valid 200 206 30d;
    proxy_cache_lock on;
    proxy_cache_use_stale error timeout updating;
    proxy_set_header Range $slice_range;
    proxy_set_header Host $proxy_host;
    proxy_set_header Authorization "";
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_hide_header x-amz-request-id;
    proxy_hide_header x-amz-id-2;
    proxy_hide_header Set-Cookie;
    proxy_ignore_headers Set-Cookie Cache-Control Expires;
    proxy_pass http://storage;

    add_header Accept-Ranges bytes always;
    add_header Cache-Control "private, max-age=3600" always;
    add_header X-Cache-Status $upstream_cache_status always;
    add_header X-Request-Id $request_id always;
  }

  location /covers/ {
    rewrite ^/covers/(.*)$ /${S3_BUCKET_COVERS}/$1? break;

    proxy_cache cover_cache;
    proxy_cache_key $uri;
    proxy_cache_valid 200 90d;
    proxy_cache_valid 404 1m;
    proxy_cache_lock on;
    proxy_set_header Host $proxy_host;
    proxy_set_header Authorization "";
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_hide_header x-amz-request-id;
    proxy_hide_header x-amz-id-2;
    proxy_ignore_headers Set-Cookie Cache-Control Expires;
    proxy_pass http://storage;

    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Cache-Status $upstream_cache_status always;
  }

  include /etc/nginx/spa/${SPA_MODE}.conf;
}
